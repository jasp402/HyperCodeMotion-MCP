{
  "version": 2,
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/d/:id/:name",
      "destination": "/api/d?id=:id&name=:name"
    },
    {
      "source": "/d/:id",
      "destination": "/api/d?id=:id"
    },
    {
      "source": "/community",
      "destination": "/api/community"
    },
    {
      "source": "/c/:id/:file",
      "destination": "/api/community?id=:id&file=:file"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 4 * * *"
    }
  ]
}
